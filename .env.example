# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://wballdjmvafqxfkmzhzw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_O8ffPch4JDpcio63RA1QUg_SB56JhoE

# Service-role key. Server-only, never exposed to the client.
# Required only for Plaid, whose plaid_items table is deny-all under RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build magic-link redirects. Vercel sets VERCEL_URL
# automatically; set this explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plaid — off unless PLAID_ENABLED is exactly "true"
PLAID_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 32-byte key for AES-256-GCM token encryption, as 64 hex chars or base64.
# Generate with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY=
